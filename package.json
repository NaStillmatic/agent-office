{
  "name": "agent-office",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "predev": "node scripts/check-deps.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "statusline:install": "node scripts/statusline-install.mjs install",
    "statusline:uninstall": "node scripts/statusline-install.mjs uninstall"
  },
  "dependencies": {
    "three": "0.186.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "25.0.9",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.10",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "vue-tsc": "3.2.2"
  }
}
